Algoritmo ejercicio_1
	// averguar el mayor de dos numeros
	definir a,b como entero; 
	mostrar "ingresa el primer numero: ";
	leer a;
	mostrar " ingresar el segundo numero: ";
	leer b;
	si a > b Entonces
		mostrar "el mayor es: ", a;
	FinSi
	si b > a entonces
		mostrar "el mayor es: ", b;
	FinSi
FinAlgoritmo
